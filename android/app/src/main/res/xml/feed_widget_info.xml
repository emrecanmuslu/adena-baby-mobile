<?xml version="1.0" encoding="utf-8"?>
<!-- API 28+/31+ öznitelikleri eski sürümlerde yok sayılır (tools:targetApi lint içindir).
     reconfigurable: uzun bas → widget ayarları ile bebeği sonradan değiştirme (K2). -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:targetApi="31"
    android:minWidth="180dp"
    android:minHeight="70dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="70dp"
    android:targetCellWidth="2"
    android:targetCellHeight="1"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/feed_widget"
    android:previewLayout="@layout/feed_widget"
    android:previewImage="@drawable/widget_preview"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:widgetFeatures="reconfigurable"
    android:configure="com.adenababy.adena_baby.FeedWidgetConfigActivity"
    android:description="@string/feed_widget_desc" />
